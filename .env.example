# ---- Copy to .env and adjust. Never commit real secrets. ----

# ---- AI model: any OpenAI-compatible endpoint (or anthropic) ----
# Groq (free, fast):  OPENAI_API_KEY=gsk_...  OPENAI_BASE_URL=https://api.groq.com/openai  OPENAI_MODEL=llama-3.3-70b-versatile
# Ollama (local):     OPENAI_API_KEY=ollama   OPENAI_BASE_URL=http://host.docker.internal:11434  OPENAI_MODEL=qwen2.5-coder:3b
# OpenAI (paid):      OPENAI_API_KEY=sk-...   OPENAI_BASE_URL=https://api.openai.com  OPENAI_MODEL=gpt-4o-mini
QUERYAI_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai
OPENAI_MODEL=llama-3.3-70b-versatile
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Security — generate your own values:
#   openssl rand -base64 48   (JWT secret, >= 32 bytes)
#   openssl rand -base64 32   (credential key, exactly 32 bytes)
QUERYAI_JWT_SECRET=change-me-local-dev-secret-change-me-local-dev-secret
QUERYAI_CREDENTIAL_KEY=bG9jYWwtZGV2LW9ubHktY3JlZGVudGlhbC1rZXktMzI=

# Application database
POSTGRES_PASSWORD=queryai

# Demo: creates analyst@queryai.app / QueryAI@2026 connected to the bundled e-commerce databases
QUERYAI_DEMO_ENABLED=true
QUERYAI_DEMO_PASSWORD=QueryAI@2026
DEMO_READER_PASSWORD=reader_pass
MYSQL_ROOT_PASSWORD=queryai-root

# ---- Semantic schema search (pgvector). local = built-in embeddings, no setup needed ----
QUERYAI_EMBEDDINGS_PROVIDER=local
# QUERYAI_EMBEDDINGS_PROVIDER=openai
# QUERYAI_EMBEDDINGS_URL=http://host.docker.internal:11434/v1/embeddings
# QUERYAI_EMBEDDINGS_MODEL=nomic-embed-text
